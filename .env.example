RELAXY_BASE_URL=https://www.relaxycode.com/v1
RELAXY_MODEL=gpt-5.6-sol
# Credentials are read by the local Codex/CCSwitch installation.
# Do not put an API key in this file or in the website.

# --- AI 文本接口（可选，配置后优先于 Codex/CCSwitch） ---
# 也可以在网页侧栏“AI 设置”里填写并保存（推荐，写进本机数据库）。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# --- 扩展信源池（校招雷达融合，可选） ---
# 扩展池默认开启；把站点池/聚合批次并入信源，每轮刷新只跑一批，避免一次抓 800+ 站。
EXTRA_POOL_ENABLED=1
EXTRA_BATCH_SIZE=25

# 渲染抓取（推荐）。申请地址 https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# AnySearch 云端兜底（匿名可用，可选填 Key 提额）
ANYSEARCH_ENABLED=1
ANYSEARCH_API_KEY=

# --- job-pro 官方招聘 API 信源（可选） ---
# 通过 npx 调用 job-pro CLI 直连 50 家大厂官方招聘 API，返回具体 JD。
# 需要本机已安装 Node.js（npm 自带 npx）。
JOBPRO_ENABLED=1
JOBPRO_BATCH_SIZE=5
JOBPRO_TIMEOUT_SECONDS=90
# 可选：只启用部分公司（逗号分隔，key 见 data/jobpro_companies.json）
# JOBPRO_COMPANIES=unitree,agibot,horizonrobotics,cambricon,xpeng
